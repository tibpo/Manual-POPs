# Chave gratuita da IA Generativa Google Gemini (gere em https://aistudio.google.com/apikey)
# Para testar localmente, crie um arquivo .env.local na raiz com esta linha preenchida:
GEMINI_API_KEY=

# Opcional: modelo do Gemini (padrao: gemini-2.5-flash com fallback para gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.5-flash
